# SAME PRODUCT: separate Django backend exposed through server-side fixed rewrites.
# Must be configured privately on the standalone OPanel frontend deployment.
OPANEL_BACKEND_ORIGIN=https://opanel-api.example.invalid
NEXT_PUBLIC_CONSOLE_WEB_ORIGIN=https://console.example.invalid

# UI gates only; Django remains authoritative.
NEXT_PUBLIC_OPANEL_TECHNICAL_LOGIN_ENABLED=false
NEXT_PUBLIC_OPANEL_UPLOAD_INSPECT_ENABLED=false
