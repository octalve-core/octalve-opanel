# Local Review-only OPanel Django backend settings
# Never commit real values; use your deployment secret manager.
DEBUG=true
DJANGO_SECRET_KEY=local-only-replace-with-unique-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production: unique PostgreSQL database for OPanel, not Console Neon.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
CONSOLE_WEB_ORIGIN=https://console.example.invalid
CONSOLE_API_BASE=https://api.example.invalid/api
OPANEL_CALLBACK_URL=https://panel.example.invalid/auth/callback/
OPANEL_PUBLIC_ORIGIN=https://panel.example.invalid
OPANEL_CLIENT_ID=octalve-opanel
# Set only in secret manager; dedicated SSO integration secret >= 32 characters.
OPANEL_CLIENT_SECRET=
# Only true when on a trusted proxy with sanitized forwarding headers.
OPANEL_TRUST_PROXY=false
OPANEL_VENDOR_READBACK_ENABLED=false
OPANEL_PROVIDER_ALLOWED_HOSTS=
